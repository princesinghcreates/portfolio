{
  "rewrites": [
    {
      "source": "/",
      "destination": "/preview-2027.html"
    },
    {
      "source": "/((?!assets/|favicon.ico|preview-2027\\.html|about-2027\\.html|prince-about-2027\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
